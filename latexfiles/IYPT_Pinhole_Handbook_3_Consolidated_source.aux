\@writefile{toc}{\contentsline {section}{\numberline {4.1}Defect 1: $r_{\max ,\text  {lens}}$ excluding 100\% of the sweep}{24}{section.4.1}\protected@file@percent }
\newlabel{sec:defect1}{{4.1}{24}{Defect 1: \texorpdfstring {$r_{\max ,\text {lens}}$}{r\_max\_lens} excluding 100\% of the sweep}{section.4.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.1}{\ignorespaces Traced to source, not just observed: \texttt  {blur\_ratio} at hex's old pick roughly \emph  {doubled} (M=4D: $4.12\to 8.25\times $) once previously-excluded off-axis holes were correctly included -- \texttt  {risk} itself is numerically identical before and after; the ghosting classification was never wrong, the blur feeding the joint cost function was.}}{24}{table.caption.33}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Defect 2: ghost-formula validation, and confirming the wiring}{24}{section.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.3}The feasible region, before optimization}{25}{section.4.3}\protected@file@percent }
\newlabel{sec:feasibleregion}{{4.3}{25}{The feasible region, before optimization}{section.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.2}{\ignorespaces The diameter axis moves with myopia; the pitch axis does not, because pitch bounds come from pupil geometry (how many holes fit in a 4mm circle), which does not know about refractive error -- the single most useful structural result of putting all three constraints on one plot.}}{25}{table.caption.34}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.4}Packing geometry: why hex}{25}{section.4.4}\protected@file@percent }
\newlabel{sec:whyhex}{{4.4}{25}{Packing geometry: why hex}{section.4.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.3}{\ignorespaces Hex wins for the geometric reason that its Voronoi cell has a smaller circumradius ($s/\sqrt  3$ vs.\ $s/\sqrt  2$), covering the pupil at a larger pitch. Caveat: no ghosting-regime sweep, MTF/CSF margin, or multi-hole PSF had ever been computed for hex when this was first found -- the advantage above was packing geometry alone, subsequently closed by this handbook's Stage 0--3 pipeline running both packings through the same corrected risk model.}}{25}{table.caption.35}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.5}Weight sensitivity, in full}{26}{section.4.5}\protected@file@percent }
\newlabel{sec:sensitivityfull}{{4.5}{26}{Weight sensitivity, in full}{section.4.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.4}{\ignorespaces \texttt  {optimise\_sensitivity.csv}. The $M{=}4$D/square answer flips to the dense, $N_{\text  {eff,worst}}{=}1$, real-ghosting-risk design at $0.5\times $ the default ghosting weight or $2\times $ the default brightness weight -- well inside any reasonable range of disagreement about how those two terms should trade off, which is exactly why Stage 3 (\S  \ref {sec:whyPareto}) does not use this weighted objective at all.}}{26}{table.caption.36}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Stage 0's own independent validation: measured $\Delta r$ (peak detection, not formula lookup) vs.\ pitch, by myopia; and the corrected-formula fit. \texttt  {stage0\_ghost\_validation/ghost\_formula\_validation.png}.}}{26}{figure.caption.37}\protected@file@percent }
