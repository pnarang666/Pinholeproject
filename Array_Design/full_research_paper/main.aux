\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces Real regenerated nearest-neighbor structure at identical spacing (pitch/ring-spacing $=4000\,\mu $m, $a_{\mathrm  {hole}}=750\,\mu $m, $M=2$D). Square: two distinct nearest-neighbor distances, 4000 and $5657\,\mu $m ($=4000\sqrt  2$, confirming the diagonal weak direction exactly). Hexagonal: one distinct distance, all six neighbors equidistant. Ring designs (6 and 8 holes/ring): genuinely offset, non-uniform ring radii, not a simple lattice -- shown as real coordinate scatter rather than forced into the same distance-count framing. Source: this analysis, regenerated directly from \texttt  {array\_calculation/degeneracy\_filter.py}'s own generator functions; see Chapter~\ref {ch:provenance}.}}{46}{figure.7.2}\protected@file@percent }
\newlabel{fig:geom-structure}{{7.2}{46}{Real regenerated nearest-neighbor structure at identical spacing (pitch/ring-spacing $=4000\,\mu $m, $a_{\mathrm {hole}}=750\,\mu $m, $M=2$D). Square: two distinct nearest-neighbor distances, 4000 and $5657\,\mu $m ($=4000\sqrt 2$, confirming the diagonal weak direction exactly). Hexagonal: one distinct distance, all six neighbors equidistant. Ring designs (6 and 8 holes/ring): genuinely offset, non-uniform ring radii, not a simple lattice -- shown as real coordinate scatter rather than forced into the same distance-count framing. Source: this analysis, regenerated directly from \texttt {array\_calculation/degeneracy\_filter.py}'s own generator functions; see Chapter~\ref {ch:provenance}}{figure.7.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Real, already-computed gaze-weighted blind\%/ghost\% for the same four matched-spacing designs as Figure~\ref {fig:geom-structure}, read directly from \texttt  {array\_data/theoretical\_data/gaze\_weighted\_metrics.csv} (not recomputed for this figure). Hexagonal is the only design with $0.00\%$ on both axes simultaneously; the ring-of-8 design trades blind\% for a real $7.58\%$ ghost fraction -- the discrete angular-gap tension (Section~\ref {sec:blinding}) hexagonal packing avoids by being simultaneously dense and well-separated in every direction.}}{46}{figure.7.3}\protected@file@percent }
\newlabel{fig:geom-consequence}{{7.3}{46}{Real, already-computed gaze-weighted blind\%/ghost\% for the same four matched-spacing designs as Figure~\ref {fig:geom-structure}, read directly from \texttt {array\_data/theoretical\_data/gaze\_weighted\_metrics.csv} (not recomputed for this figure). Hexagonal is the only design with $0.00\%$ on both axes simultaneously; the ring-of-8 design trades blind\% for a real $7.58\%$ ghost fraction -- the discrete angular-gap tension (Section~\ref {sec:blinding}) hexagonal packing avoids by being simultaneously dense and well-separated in every direction}{figure.7.3}{}}
