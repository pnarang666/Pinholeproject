\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Per-hole vignetting transmission $T_{\mathrm  {hole}}(\varphi )=A_{\mathrm  {overlap}}/(\pi R_h^2)$ vs.\ gaze angle $\varphi $, three hole diameters, $R_p=2000\,\mu $m, $R_{\mathrm  {rot}}=13.5$\,mm. Transmission is exactly $1.0$ (full illumination) until the pupil begins to slide off the hole, then falls to exactly $0.0$ over a narrow angular transition -- the sharpness of this cutoff (a few degrees, not a gradual taper) is what makes vignetting a genuine on/off hazard rather than a smooth brightness gradient. The dashed vertical lines mark $|\varphi |=25^\circ $, this formula's (Equation~\ref {eq:pupil-shift}) own stated small-angle validity limit -- Chapter~\ref {ch:model-b}'s $27^\circ $ extrapolated bin sits just outside it, flagged there as extrapolated, not silently trusted. Source: \texttt  {Array\_Design/array\_optimization/vignetting\_validation.png}, mtime 2026-08-15, the original validation run \texttt  {vignetting\_overlap.py} was copied from.}}{33}{figure.5.2}\protected@file@percent }
\newlabel{fig:vignetting-transmission}{{5.2}{33}{Per-hole vignetting transmission $T_{\mathrm {hole}}(\varphi )=A_{\mathrm {overlap}}/(\pi R_h^2)$ vs.\ gaze angle $\varphi $, three hole diameters, $R_p=2000\,\mu $m, $R_{\mathrm {rot}}=13.5$\,mm. Transmission is exactly $1.0$ (full illumination) until the pupil begins to slide off the hole, then falls to exactly $0.0$ over a narrow angular transition -- the sharpness of this cutoff (a few degrees, not a gradual taper) is what makes vignetting a genuine on/off hazard rather than a smooth brightness gradient. The dashed vertical lines mark $|\varphi |=25^\circ $, this formula's (Equation~\ref {eq:pupil-shift}) own stated small-angle validity limit -- Chapter~\ref {ch:model-b}'s $27^\circ $ extrapolated bin sits just outside it, flagged there as extrapolated, not silently trusted. Source: \texttt {Array\_Design/array\_optimization/vignetting\_validation.png}, mtime 2026-08-15, the original validation run \texttt {vignetting\_overlap.py} was copied from}{figure.5.2}{}}
